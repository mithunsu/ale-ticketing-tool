# Local development environment variables for ALE Ticket Management Tool
#
# HOW TO USE:
#   1. Copy this file to .env for local development:
#        Copy-Item .env.example .env
#   2. Replace the password placeholder with a strong local development password
#      before starting PostgreSQL (see POSTGRES_PASSWORD below).
#   3. Never commit the real .env file — it is excluded by .gitignore.
#
# NOTE: These credentials belong to the local PostgreSQL Docker container.
# They are not application user passwords and are not used in production.

POSTGRES_DB=ale_ticketing
POSTGRES_USER=ale_ticket_user

# Replace this placeholder with a strong local development password before
# running docker compose up. Do not use this placeholder as an actual password.
POSTGRES_PASSWORD=replace_with_local_database_password
