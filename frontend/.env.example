# Base URL for the backend API.
# Leave empty for local development: the Vite dev server proxies /api to
# http://localhost:5000 (see vite.config.js), regardless of which port Vite uses.
# Set this only for deployments where the frontend and backend are hosted at
# different origins, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
